# Set landing.php as default directory index page
DirectoryIndex landing.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^research-director(?:/.*)?$ dashboard.php [R=302,L]
    RewriteRule ^extension-director(?:/.*)?$ dashboard.php [R=302,L]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

<FilesMatch "^(config\.local\.php|.*\.(sql|ini|log))$">
    Require all denied
</FilesMatch>
