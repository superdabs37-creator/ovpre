{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/landing$",
      "dest": "/index.html"
    },
    {
      "src": "^/login$",
      "dest": "/login.html"
    },
    {
      "src": "^/register$",
      "dest": "/register.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/dashboard.html"
    },
    {
      "src": "^/research$",
      "dest": "/research.html"
    },
    {
      "src": "^/extension$",
      "dest": "/extension.html"
    },
    {
      "src": "^/admin-reports$",
      "dest": "/admin-reports.html"
    },
    {
      "src": "^/admin-users$",
      "dest": "/admin-users.html"
    },
    {
      "src": "^/system-activity$",
      "dest": "/system-activity.html"
    },
    {
      "src": "^/system-backup$",
      "dest": "/system-backup.html"
    },
    {
      "src": "^/admin-settings$",
      "dest": "/admin-settings.html"
    },
    {
      "src": "^/admin-documents$",
      "dest": "/admin-documents.html"
    },
    {
      "src": "^/announcements$",
      "dest": "/announcements.html"
    },
    {
      "src": "^/activities$",
      "dest": "/activities.html"
    },
    {
      "src": "^/notifications$",
      "dest": "/notifications.html"
    },
    {
      "src": "^/profile$",
      "dest": "/profile.html"
    },
    {
      "src": "^/forgot-password$",
      "dest": "/forgot-password.html"
    },
    {
      "src": "^/search$",
      "dest": "/search.html"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/(.*)\\.html$",
      "dest": "/$1.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/$1"
    }
  ]
}
