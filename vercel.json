{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/uploads/records/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/frontend/uploads/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/landing",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/register",
      "destination": "/frontend/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/frontend/dashboard.html"
    },
    {
      "source": "/research",
      "destination": "/frontend/research.html"
    },
    {
      "source": "/extension",
      "destination": "/frontend/extension.html"
    },
    {
      "source": "/admin-reports",
      "destination": "/frontend/admin-reports.html"
    },
    {
      "source": "/admin-users",
      "destination": "/frontend/admin-users.html"
    },
    {
      "source": "/system-activity",
      "destination": "/frontend/system-activity.html"
    },
    {
      "source": "/system-backup",
      "destination": "/frontend/system-backup.html"
    },
    {
      "source": "/admin-storage",
      "destination": "/frontend/dashboard.html"
    },
    {
      "source": "/admin-settings",
      "destination": "/frontend/admin-settings.html"
    },
    {
      "source": "/admin-documents",
      "destination": "/frontend/admin-documents.html"
    },
    {
      "source": "/announcements",
      "destination": "/frontend/announcements.html"
    },
    {
      "source": "/activities",
      "destination": "/frontend/activities.html"
    },
    {
      "source": "/notifications",
      "destination": "/frontend/notifications.html"
    },
    {
      "source": "/profile",
      "destination": "/frontend/profile.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/frontend/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/frontend/reset-password.html"
    },
    {
      "source": "/submitted-files",
      "destination": "/frontend/submitted-files.html"
    },
    {
      "source": "/upload-document",
      "destination": "/frontend/upload-document.html"
    },
    {
      "source": "/admin-pending-users",
      "destination": "/frontend/admin-pending-users.html"
    },
    {
      "source": "/search",
      "destination": "/frontend/search.html"
    },
    {
      "source": "/404",
      "destination": "/frontend/404.html"
    },
    {
      "source": "/403",
      "destination": "/frontend/403.html"
    },
    {
      "source": "/500",
      "destination": "/frontend/500.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
