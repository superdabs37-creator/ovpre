{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/uploads/records/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/landing$",
      "dest": "/landing.html"
    },
    {
      "src": "^/reset-password$",
      "dest": "/reset-password.html"
    },
    {
      "src": "^/submitted-files$",
      "dest": "/submitted-files.html"
    },
    {
      "src": "^/upload-document$",
      "dest": "/upload-document.html"
    },
    {
      "src": "^/admin-pending-users$",
      "dest": "/admin-pending-users.html"
    },
    {
      "src": "^/login$",
      "dest": "/login.html"
    },
    {
      "src": "^/register$",
      "dest": "/register.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/dashboard.html"
    },
    {
      "src": "^/research$",
      "dest": "/research.html"
    },
    {
      "src": "^/extension$",
      "dest": "/extension.html"
    },
    {
      "src": "^/admin-reports$",
      "dest": "/admin-reports.html"
    },
    {
      "src": "^/admin-users$",
      "dest": "/admin-users.html"
    },
    {
      "src": "^/system-activity$",
      "dest": "/system-activity.html"
    },
    {
      "src": "^/system-backup$",
      "dest": "/system-backup.html"
    },
    {
      "src": "^/admin-settings$",
      "dest": "/admin-settings.html"
    },
    {
      "src": "^/admin-documents$",
      "dest": "/admin-documents.html"
    },
    {
      "src": "^/announcements$",
      "dest": "/announcements.html"
    },
    {
      "src": "^/activities$",
      "dest": "/activities.html"
    },
    {
      "src": "^/notifications$",
      "dest": "/notifications.html"
    },
    {
      "src": "^/profile$",
      "dest": "/profile.html"
    },
    {
      "src": "^/forgot-password$",
      "dest": "/forgot-password.html"
    },
    {
      "src": "^/search$",
      "dest": "/search.html"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/(.*)\\.html$",
      "dest": "/$1.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/$1"
    }
  ]
}
